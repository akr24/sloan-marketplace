# Copy to .env to override the compose defaults. Every value is optional
# for local development.

POSTGRES_USER=sloan
POSTGRES_PASSWORD=sloan
POSTGRES_DB=sloan_marketplace
POSTGRES_PORT=5434
BACKEND_PORT=8081
FRONTEND_PORT=5174

# "dev" enables POST /api/dev/whatsapp (bot simulator). Use "prod" when deployed.
APP_ENV=dev
# Public URL of the web app; the bot links listings to it.
APP_URL=http://localhost:5174
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Email for one-time codes. Leave SMTP_HOST empty to print codes to the
# backend log instead. Free options:
#   Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=you@gmail.com,
#           SMTP_PASSWORD=<16-char app password from myaccount.google.com/apppasswords>
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com (300 emails/day free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Sloan Marketplace <you@gmail.com>

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup).
# Leave the last two empty to print bot replies to the backend log instead.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
